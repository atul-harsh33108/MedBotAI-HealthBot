# HealthBot configuration template.
#
# Copy this file to `.env` in the same folder as healthbot.ipynb and fill in your
# own values:
#
#     Windows PowerShell:  Copy-Item .env.example .env
#     macOS / Linux:       cp .env.example .env
#
# The project brief calls this file `config.env`. This project uses `.env`; if you
# prefer the brief's name, rename the file and change the `load_dotenv(".env",
# override=True)` call in section 1 of the notebook to match.
#
# These five variables are the only ones the notebook reads. Keep real keys out of
# version control: `.env` is listed in .gitignore, this template is not.


# --- Search (required) -------------------------------------------------------
# Free account and key: https://app.tavily.com/home  (first 1000 requests free)
# Section 1 asserts on this, so a missing value fails on the first cell rather
# than halfway through a patient session.
TAVILY_API_KEY="tvly-your-tavily-key-here"


# --- LLM providers (at least one required) -----------------------------------
# The model menu in section 3 only offers providers it finds a key for, and any
# provider you are not using simply does not appear. With both keys set, the one
# you do not pick becomes an automatic fallback if your preferred provider hits
# its free-tier cap mid-session.

# Google Gemini. Key: https://aistudio.google.com/apikey
# Appears as menu option 1. The model id is set by GOOGLE_MODEL in section 3 of
# the notebook, not here.
GOOGLE_API_KEY="AIza-your-google-key-here"

# OpenRouter. Key: https://openrouter.ai/keys
# Appears as menu option 2. Reached through ChatOpenAI pointed at OpenRouter's
# base URL, which is why langchain-openai is a dependency even though no OpenAI
# model is offered.
OPENROUTER_API_KEY="sk-or-your-openrouter-key-here"


# --- Optional OpenRouter settings --------------------------------------------
# Which model OpenRouter should serve. Unlike GOOGLE_MODEL this one is read from
# the environment, so you can change models without touching the notebook. Note
# that re-running section 1 and then section 3 is needed for an edit to show up.
# Default if unset: openrouter/auto
OPENROUTER_MODEL="minimax/minimax-m3:free"

# Override only if you are using a proxy or a non-default OpenRouter host.
# Default if unset: https://openrouter.ai/api/v1
OPENROUTER_ENDPOINT="https://openrouter.ai/api/v1"
